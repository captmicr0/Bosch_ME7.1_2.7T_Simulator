.program capture17
; Sample GP10..GP26: coils GP10..15, injector GP17..21/GP26, marker GP22.
.wrap_target
    in pins, 17
    push block
.wrap

% c-sdk {
static inline void capture17_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
    pio_sm_config cfg = capture13_program_get_default_config(offset);
    sm_config_set_in_pins(&cfg, base_pin);
    sm_config_set_in_shift(&cfg, false, false, 32);
    sm_config_set_fifo_join(&cfg, PIO_FIFO_JOIN_RX);
    for (uint i = base_pin; i < base_pin + 17; ++i) {
        if (i != 22 && i != 16) pio_gpio_init(pio, i); // GP22 must remain SIO output while PIO reads its pad
        gpio_set_pulls(i, false, false);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, base_pin, 17, false);
    pio_sm_init(pio, sm, offset, &cfg);
}
%}
